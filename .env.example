# Supabase — conta do cliente e dados na nuvem.
# Painel do Supabase → Project Settings → API.
# Sem estas duas variáveis o app roda inteiro no aparelho, sem tela de login.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Modo demonstração: "true" popula o app com o bebê fictício.
# Deixe vazio em produção.
VITE_DEMO_MODE=
